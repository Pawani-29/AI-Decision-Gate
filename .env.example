# Microsoft Foundry project endpoint; do not commit a populated .env file.
FOUNDRY_PROJECT_ENDPOINT=

# Existing Microsoft Foundry agent name.
FOUNDRY_AGENT_NAME=

# Draft version created by scripts/create_dynamic_foundry_agent_version.py.
# Required only when a request supplies a runtime vector_store_id.
FOUNDRY_DYNAMIC_AGENT_VERSION=
